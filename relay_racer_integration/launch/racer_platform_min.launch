<launch>
  <arg name="use_sim_time" default="true"/>
  <arg name="drone_num" default="4"/>
  <arg name="first_drone_id" default="1"/>
  <arg name="relay_policy_mode" default="rule"/>

  <param name="/use_sim_time" value="$(arg use_sim_time)"/>

  <node pkg="relay_racer_integration" type="racer_comm_controller_node" name="racer_comm_controller" output="screen">
    <rosparam command="load" file="$(find relay_racer_integration)/config/relay_rules.yaml"/>
    <param name="relay_policy_mode" value="$(arg relay_policy_mode)"/>
  </node>

  <node pkg="relay_racer_integration" type="racer_topic_router_node" name="racer_topic_router" output="screen">
    <rosparam command="load" file="$(find relay_racer_integration)/config/relay_rules.yaml"/>
    <param name="drone_num" value="$(arg drone_num)"/>
    <param name="first_drone_id" value="$(arg first_drone_id)"/>
  </node>

  <node pkg="relay_racer_integration" type="racer_phy_connector_node" name="racer_phy_connector_1" output="screen">
    <param name="racer_id" value="1"/>
    <param name="platform_id" value="0"/>
    <param name="odom_topic" value="/relay_bridge/odom_1"/>
  </node>

  <node pkg="relay_racer_integration" type="racer_phy_connector_node" name="racer_phy_connector_2" output="screen">
    <param name="racer_id" value="2"/>
    <param name="platform_id" value="1"/>
    <param name="odom_topic" value="/relay_bridge/odom_2"/>
  </node>

  <node pkg="relay_racer_integration" type="racer_phy_connector_node" name="racer_phy_connector_3" output="screen">
    <param name="racer_id" value="3"/>
    <param name="platform_id" value="2"/>
    <param name="odom_topic" value="/relay_bridge/odom_3"/>
  </node>

  <node pkg="relay_racer_integration" type="racer_phy_connector_node" name="racer_phy_connector_4" output="screen">
    <param name="racer_id" value="4"/>
    <param name="platform_id" value="3"/>
    <param name="odom_topic" value="/relay_bridge/odom_4"/>
  </node>

  <!--
    Stage-1 launch skeleton:
    1. Start the communication platform separately.
    2. Start RACER nodes through exploration_manager/launch/single_drone_planner_realworld.xml.
    3. Remap each RACER planner to the send_i / recv_i topics already split by RACER.
    4. Replace /relay_bridge/odom_i with the actual odometry topic exported to the platform PHY bridge.
  -->
</launch>

    <param name="post_startup_service_delay_sec" value="$(arg trigger_post_startup_service_delay_sec)"/>
    <param name="post_startup_service_repeat_count" value="$(arg trigger_post_startup_service_repeat_count)"/>
    <param name="post_startup_service_repeat_period_sec" value="$(arg trigger_post_startup_service_repeat_period_sec)"/>
    <param name="planning_artifact_agent_ids" value="$(arg trigger_planning_artifact_agent_ids)"/>
    <param name="planning_artifact_min_messages" value="$(arg trigger_planning_artifact_min_messages)"/>
    <param name="service_agent_x_positions" value="$(arg trigger_service_agent_x_positions)"/>
    <param name="service_edges" value="$(arg trigger_service_edges)"/>
    <param name="goal_x" value="1.0"/>
    <param name="goal_y" value="0.0"/>
    <param name="goal_z" value="1.0"/>
  </node>
</launch>

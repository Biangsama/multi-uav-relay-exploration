      <arg name="cx" value="324.0879821777344"/>
      <arg name="cy" value="239.10362243652344"/>
      <arg name="fx" value="385.69793701171875"/>
      <arg name="fy" value="385.69793701171875"/>
      <arg name="max_vel" value="1.0"/>
      <arg name="max_acc" value="1.0"/>
      <arg name="simulation" value="true"/>

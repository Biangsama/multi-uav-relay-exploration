<?xml version="1.0"?>
<package format="2">
  <name>coordinator</name>
  <version>0.0.0</version>
  <description>ROS1 coordinator for the DANCERS robotic and network co-simulator.</description>

  <maintainer email="zby@example.com">zby</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>catkin</buildtool_depend>

  <build_depend>connector_core</build_depend>
  <build_depend>protobuf_msgs</build_depend>
  <build_depend>roscpp</build_depend>
  <build_depend>rosgraph_msgs</build_depend>

  <build_export_depend>connector_core</build_export_depend>
  <build_export_depend>protobuf_msgs</build_export_depend>
  <build_export_depend>roscpp</build_export_depend>
  <build_export_depend>rosgraph_msgs</build_export_depend>

  <exec_depend>connector_core</exec_depend>
  <exec_depend>protobuf_msgs</exec_depend>
  <exec_depend>roscpp</exec_depend>
  <exec_depend>rosgraph_msgs</exec_depend>
</package>
